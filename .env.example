# ---------------------------------------------------------------------------
# ReelVault configuration. Copy to `.env` and adjust. NEVER commit real keys.
# ---------------------------------------------------------------------------

# --- App ---
FRONTEND_PORT=8080
ENVIRONMENT=development
DEBUG=true
API_PREFIX=/api

# --- Postgres (used by docker-compose to init the db service) ---
POSTGRES_USER=reelvault
POSTGRES_PASSWORD=reelvault
POSTGRES_DB=reelvault
# SQLAlchemy URL used by the backend. Host is the compose service name `db`.
DATABASE_URL=postgresql+psycopg://reelvault:reelvault@db:5432/reelvault

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
USE_CELERY=true

# --- Storage (inside the container; backed by the `appdata` volume) ---
UPLOAD_DIR=/data/uploads
MEDIA_DIR=/data/media
MAX_UPLOAD_MB=500

# --- Media retrieval (yt-dlp) ---
MEDIA_DOWNLOAD_ENABLED=true
MEDIA_DOWNLOAD_TIMEOUT_SEC=120
MEDIA_MAX_FILESIZE_MB=200
# Optional: path (inside the container) to your own Instagram cookies.txt so
# yt-dlp can fetch reels that are login-walled for anonymous access. This is NOT
# an API key — it's your own browser session. Export cookies from a browser
# where you're logged in (see README), save as secrets/cookies.txt, and it's
# mounted read-only at /secrets/cookies.txt. Only used when the file exists.
YTDLP_COOKIES_FILE=/secrets/cookies.txt

# --- Transcription (faster-whisper) ---
TRANSCRIPTION_ENABLED=true
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# --- LLM summarization + chat ---
# provider: openai | gemini | stub   (stub runs fully offline, no key needed)
LLM_PROVIDER=stub
LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=sk-...                  # required for openai/gemini
# LLM_BASE_URL=                       # optional, for OpenAI-compatible endpoints
# CHAT_MODEL=                         # defaults to LLM_MODEL

# --- Embeddings (semantic search + RAG) ---
# provider: openai | gemini | stub   (stub = deterministic offline embeddings)
EMBEDDING_PROVIDER=stub
EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_API_KEY=sk-...
EMBEDDING_DIM=1536

# NOTE: EMBEDDING_DIM must match the provider's output (OpenAI
# text-embedding-3-small = 1536). If you change it after creating the DB,
# recreate the reel_chunks table / re-run migrations.
